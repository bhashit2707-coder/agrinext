# AgriNext Environment Configuration Template
# =====================================================================
# Official NASA Earthdata Login Registration:
# https://urs.earthdata.nasa.gov/
#
# Register for a free NASA Earthdata account to authorize live extractions:
# 1. NASA SMAP SPL3SMP_E V006 via AppEEARS: https://appeears.earthdatacloud.nasa.gov/
# 2. NASA GPM IMERG V07 Final Run via NASA GES DISC: https://gpm.nasa.gov/data/directory
# 3. NASA GLDAS-2.1 Noah monthly via NASA GES DISC: https://ldas.gsfc.nasa.gov/gldas/gldas-get-data
#
# SECURITY RULES:
# - NEVER commit this file with real secrets or passwords to Git/GitHub.
# - Keep Earthdata credentials in backend/.env only.
# - Credentials and tokens are NEVER exposed to the frontend browser application.
# =====================================================================

# NASA Earthdata Login Credentials (Required for live SMAP, GPM and GLDAS extractions)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Optional: NASA Earthdata Bearer Token (can be used in place of username/password)
EARTHDATA_BEARER_TOKEN=your_optional_earthdata_bearer_token

# API & Server Configuration
API_PORT=8000
AGRINEXT_ENV=development

# AppEEARS task polling (seconds)
APPEEARS_POLL_INTERVAL_SEC=5
APPEEARS_MAX_WAIT_SEC=600

# Authentication and browser security
# Comma-separated exact frontend origins. Never use * with credentialed cookies.
AGRINEXT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true behind HTTPS in production; keep false for local HTTP development.
AGRINEXT_COOKIE_SECURE=false
# Use none + secure=true only when frontend and API are on different sites (HTTPS).
AGRINEXT_COOKIE_SAMESITE=lax
AGRINEXT_SESSION_TTL_HOURS=12

# Sentinel Hub OAuth credentials (required for Sentinel-2 pixel processing)
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# Optional SQLite path. Prefer an absolute persistent-volume path in production.
# AGRINEXT_DB_PATH=/absolute/path/to/agrinext.db

# NASA POWER response cache lifetime (default: 24 hours)
NASA_POWER_CACHE_TTL_SECONDS=86400

# Persistent NASA background job worker pool (1-4 threads; default: 2)
AGRINEXT_NASA_JOB_WORKERS=2
